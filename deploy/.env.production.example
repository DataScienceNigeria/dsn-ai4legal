# Production environment for the Legal Operations Platform.
#
# Copy to .env at the repository root on the server and fill in every value
# marked CHANGE. The development .env.example is not a starting point for this
# one: it carries defaults that the platform deliberately refuses to run on.
#
# Generate each secret separately, and never reuse one between environments:
#   openssl rand -base64 48

DSNLAI_ENV=production

# Signs every session token. The platform refuses to start outside development
# while this is the value in the repository, because anybody holding that key
# could sign a token for any role.
DSNLAI_SECRET_KEY=CHANGE

# The addresses a browser may call the API from, comma separated. Leave this
# empty where one address fronts both the interface and the API, which is what
# the nginx configuration in deploy/nginx does: same origin, so there is no
# cross-origin request to allow. Set it only if they are served separately.
DSNLAI_ALLOWED_ORIGINS=

# What the browser calls. This is inlined into the web bundle when the image is
# built, so changing it needs a rebuild of web, not a restart. With one address
# fronting both, it is that address with no port and no path.
NEXT_PUBLIC_API_BASE_URL=https://legal.dsnsandbox.com

# Ports on the server's loopback. nginx proxies to these, so they do not need
# to be reachable from outside and should not be opened in the firewall.
DSNLAI_API_PORT=8000
DSNLAI_WEB_PORT=3000

# ---------------------------------------------------------------- the database
POSTGRES_DB=dsn_lai
POSTGRES_USER=dsnlai_owner
POSTGRES_PASSWORD=CHANGE
DSNLAI_APP_DB_USER=dsnlai_app
DSNLAI_APP_DB_PASSWORD=CHANGE
# The database listens on the container network only. Publishing it is not
# required and every published port is one more thing facing the internet.
DSNLAI_DB_PORT=5434
DSNLAI_REDIS_PORT=6380

# ---------------------------------------------------------------- documents
# azure in production. The platform refuses to start if the container cannot be
# reached, rather than accepting uploads it cannot keep. The container must
# have version-level immutability enabled, which executed copies are written
# under, and the host's managed identity needs Storage Blob Data Contributor.
DSNLAI_STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_URL=https://CHANGE.blob.core.windows.net
AZURE_STORAGE_CONTAINER=ai4legal
# Staging only. Leave empty in production and use the managed identity.
AZURE_STORAGE_CONNECTION_STRING=

# ---------------------------------------------------------------- backups
# scripts/backup.sh refuses to run without this. Keep it somewhere other than
# this server: a passphrase stored beside the backup protects nothing.
DSNLAI_BACKUP_PASSPHRASE=CHANGE

# ---------------------------------------------------------------- the AI layer
# With no key every capability refuses and names its manual path, which is a
# working deployment with the AI switched off rather than a broken one.
OPENAI_API_KEY=

# ---------------------------------------------------------------- sign-in
# local issues the platform's own tokens against the accounts it holds. Switch
# to oidc once Entra ID or Google Workspace is wired up, and the roles then
# arrive from the directory.
DSNLAI_AUTH_MODE=local
DSNLAI_OIDC_ISSUER=
DSNLAI_OIDC_AUDIENCE=dsn-lai-api

# Roles that must hold a second factor before they can publish, sign, restrict
# or administer. Signing in is never gated on it, so nobody is locked out.
DSNLAI_MFA_ENABLED=true
DSNLAI_MFA_REQUIRED_ROLES=admin,head_of_legal

# ---------------------------------------------------------------- signature
# Optional, and off until there is a mail relay. The platform only sends a
# document to OpenSign when OPENSIGN_EMAIL and OPENSIGN_PASSWORD are both set;
# without them it issues a signature reference internally and says plainly that
# nothing left the platform, which is a working deployment rather than a broken
# one. Wet-ink execution is recorded either way.
DSNLAI_OPENSIGN_PORT=8080
DSNLAI_OPENSIGN_CLIENT_PORT=3200
OPENSIGN_MASTER_KEY=CHANGE
OPENSIGN_EMAIL=
OPENSIGN_PASSWORD=

# Turn signature on properly by doing all three at once, because each alone
# fails in a way that looks like the signature failing rather than the
# deployment missing a piece:
#   1. A relay, below. Signature links are emailed to people outside the
#      organisation, so a mailbox that goes nowhere loses them silently.
#   2. SERVER_URL and PUBLIC_URL in docker-compose.yml, which are localhost and
#      have to be addresses a signer's browser can reach.
#   3. OPENSIGN_PFX_BASE64, the certificate embedded into the signed PDF.
#      Unset, the Finish button throws after somebody has already signed.
OPENSIGN_SMTP_ENABLE=false
OPENSIGN_SMTP_HOST=
OPENSIGN_SMTP_PORT=587
OPENSIGN_SMTP_USER=
OPENSIGN_SMTP_PASS=
OPENSIGN_PFX_BASE64=

# ---------------------------------------------------------------- notifications
# log writes the event to the log and reports it as written to the log, not as
# sent. Set smtp once a relay exists, so obligation reminders actually arrive.
DSNLAI_NOTIFY_TRANSPORT=log

# ---------------------------------------------------------------- n8n
# Plumbing: it polls the legal mailbox and hands each message to the webhook.
# Bound to the server's loopback in the production overlay, so it is reached
# over an SSH tunnel rather than published. integrations/n8n/OUTLOOK.md is the
# setup.
DSNLAI_N8N_PORT=5678
# Encrypts the stored mailbox credential. Lose it and every saved credential in
# n8n has to be entered again, so keep it with the other secrets.
N8N_ENCRYPTION_KEY=CHANGE
# n8n 1.x ignores these and asks for an owner account on first visit instead.
# Set them anyway: an older image on the tag honours them, and the difference
# between the two is an editor open to anyone who reaches the port.
N8N_USER=admin
N8N_PASSWORD=CHANGE
# The mailbox the poll reads. It must also be on the platform's approved list
# or every message is refused and the attempt recorded:
#   docker compose ... run --rm api python -m app.mailbox legal@dsn.org --entity DSN
LEGAL_MAILBOX=legal@dsn.org
