# ---------------------------------------------------------------------------
# Legal Operations Platform, environment template.
# Copy to .env and fill in. Never commit .env (see LOP-NFR-15).
# ---------------------------------------------------------------------------

# Application
DSNLAI_ENV=development
DSNLAI_SECRET_KEY=change-me-in-every-environment
DSNLAI_API_PORT=8000
DSNLAI_WEB_PORT=3000

# Database. The application connects as dsnlai_app, which is subject to row-level
# security. Migrations connect as dsnlai_owner, which is not (LOP-NFR-13).
POSTGRES_DB=dsn_lai
POSTGRES_USER=dsnlai_owner
POSTGRES_PASSWORD=dsnlai_owner_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DSNLAI_APP_DB_USER=dsnlai_app
DSNLAI_APP_DB_PASSWORD=dsnlai_app_dev_password

# Redis and Celery
REDIS_URL=redis://redis:6379/0

# Object storage, MinIO. Object lock backs the immutable executed archive (M08).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=dsn-lai-minio-access
MINIO_SECRET_KEY=dsn-lai-minio-secret-dev
MINIO_BUCKET=dsn-lai-documents
MINIO_SECURE=false

# Identity. Keycloak federates Entra ID and Google Workspace by OIDC (M15).
# With DSNLAI_AUTH_MODE=local the API issues its own development tokens instead.
DSNLAI_AUTH_MODE=local
DSNLAI_OIDC_ISSUER=http://keycloak:8080/realms/lop
DSNLAI_OIDC_AUDIENCE=dsn-lai-api
DSNLAI_OIDC_JWKS_URL=http://keycloak:8080/realms/lop/protocol/openid-connect/certs

# AI gateway. Routes are selected per data class, see PRD section 13.4.
# With no key present the gateway falls back to the offline deterministic
# provider, so the platform runs without reaching any external service.
OPENAI_API_KEY=
# Leave blank for the public API, or point at a compatible gateway.
OPENAI_BASE_URL=
# The model identifier is configuration. Set it to a model the account has.
DSNLAI_AI_DEFAULT_MODEL=gpt-5
DSNLAI_AI_SEND_EFFORT=true
DSNLAI_AI_EFFORT=high
DSNLAI_AI_TIMEOUT_SECONDS=120
# Published rates, used for the AI usage report rather than for billing.
DSNLAI_AI_INPUT_COST_PER_MTOK=1.25
DSNLAI_AI_OUTPUT_COST_PER_MTOK=10.0

# Self-hosted open-weights model, the only route permitted for restricted
# content because nothing leaves the platform network.
DSNLAI_AI_LOCAL_BASE_URL=http://vllm:8000/v1
DSNLAI_AI_LOCAL_MODEL=local-open-weights

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── n8n, plumbing only ───────────────────────────────────────────────────────
# n8n polls approved mailboxes and posts to the signed ingest endpoint. It
# carries no legal logic and never writes to the database (PRD section 11.3).
DSNLAI_N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=
N8N_ENCRYPTION_KEY=

# ── code quality ─────────────────────────────────────────────────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=