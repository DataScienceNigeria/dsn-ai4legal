# ---------------------------------------------------------------------------
# Legal Operations Platform, environment template.
# Copy to .env and fill in. Never commit .env (see LOP-NFR-15).
# ---------------------------------------------------------------------------

# Application
DSNLAI_ENV=development
DSNLAI_SECRET_KEY=change-me-in-every-environment
DSNLAI_API_PORT=8000
DSNLAI_WEB_PORT=3004

# Database. The application connects as dsnlai_app, which is subject to row-level
# security. Migrations connect as dsnlai_owner, which is not (LOP-NFR-13).
POSTGRES_DB=dsn_lai
POSTGRES_USER=dsnlai_owner
POSTGRES_PASSWORD=dsnlai_owner_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DSNLAI_APP_DB_USER=dsnlai_app
DSNLAI_APP_DB_PASSWORD=dsnlai_app_dev_password

# Redis and Celery
REDIS_URL=redis://redis:6379/0

# Object storage, MinIO. Object lock backs the immutable executed archive (M08).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=dsn-lai-minio-access
MINIO_SECRET_KEY=dsn-lai-minio-secret-dev
MINIO_BUCKET=dsn-lai-documents
MINIO_SECURE=false

# Identity. Keycloak federates Entra ID and Google Workspace by OIDC (M15).
# With DSNLAI_AUTH_MODE=local the API issues its own development tokens instead.
DSNLAI_AUTH_MODE=local
DSNLAI_OIDC_ISSUER=http://keycloak:8080/realms/lop
DSNLAI_OIDC_AUDIENCE=dsn-lai-api
DSNLAI_OIDC_JWKS_URL=http://keycloak:8080/realms/lop/protocol/openid-connect/certs
# Where the roles and the entities sit in the token. Dotted paths are followed,
# so realm_access.roles works for a stock Keycloak realm.
DSNLAI_OIDC_ROLES_CLAIM=roles
DSNLAI_OIDC_ENTITIES_CLAIM=entities
DSNLAI_OIDC_JWKS_CACHE_SECONDS=3600
# Whether a locally issued token is still accepted while OIDC is on. Off in
# anything but a migration window.
DSNLAI_OIDC_ALLOW_LOCAL_FALLBACK=false

# ── the integrations behind the stand-ins ────────────────────────────────────
# Every one of these has a fallback that runs when it is not configured, and
# each fallback reports what it actually did rather than a success it cannot
# support. Leaving this whole block unset is a supported configuration.

# Multi-factor authentication, TOTP. Demanded of the roles named here before
# any step-up action. No external service is involved.
# ENABLED=false turns the module off wholesale: no code at sign-in, none for
# a privileged act, and enrolment still works so it can be exercised before
# it is turned back on. It is a development convenience and nothing else.
DSNLAI_MFA_ENABLED=true
DSNLAI_MFA_REQUIRED_ROLES=admin,head_of_legal
DSNLAI_MFA_ISSUER=DSN Legal Operations
DSNLAI_TOTP_WINDOW=1

# SCIM 2.0 provisioning. The directory presents the token as a bearer token.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DSNLAI_SCIM_ENABLED=false
DSNLAI_SCIM_TOKEN=
DSNLAI_SCIM_DEFAULT_ENTITY=DSN

# E-signature. internal is the built-in simulation. It binds the request to the
# approved hash, refuses an unapproved one and completes through the same
# signed webhook a real provider calls, but nothing leaves the platform and no
# signer is ever contacted. Set the provider to docuseal and supply a key to
# send for real.
DSNLAI_SIGNATURE_PROVIDER=internal
DOCUSEAL_BASE_URL=https://api.docuseal.com
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=
# The secret DocuSeal signs its completion callback with. Without it the
# webhook is refused, which is the right answer to an unverified caller.
DOCUSEAL_WEBHOOK_SECRET=

# Notification delivery. log keeps the outbox writing to the log, which is what
# it did before any transport existed. smtp sends mail, webhook posts a signed
# payload to DSNLAI_WEBHOOK_URL.
DSNLAI_NOTIFY_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=legal@dsn.example
# Credentials travel in cleartext without this. Turn it off only for a server
# on a trusted network that offers no TLS at all.
SMTP_STARTTLS=true
DSNLAI_WEBHOOK_URL=
DSNLAI_WEBHOOK_SECRET=

# Malware scanning, ClamAV over its TCP socket. With no scanner the magic-byte
# heuristic applies and reports itself as a heuristic rather than as clean.
DSNLAI_CLAMAV_HOST=
DSNLAI_CLAMAV_PORT=3310
DSNLAI_CLAMAV_TIMEOUT_SECONDS=30

# Embeddings. deterministic is the offline projection. openai uses the key
# below. The width is pinned by the column type, so a model of a different
# width needs a migration before it can be selected.
DSNLAI_EMBEDDING_PROVIDER=deterministic
DSNLAI_EMBEDDING_MODEL=text-embedding-3-small

# AI gateway. Routes are selected per data class, see PRD section 13.4.
# With no key present the gateway falls back to the offline deterministic
# provider, so the platform runs without reaching any external service.
OPENAI_API_KEY=
# Leave blank for the public API, or point at a compatible gateway.
OPENAI_BASE_URL=
# The model identifier is configuration. Set it to a model the account has.
DSNLAI_AI_DEFAULT_MODEL=gpt-5
DSNLAI_AI_SEND_EFFORT=true
DSNLAI_AI_EFFORT=high
DSNLAI_AI_TIMEOUT_SECONDS=120
# Published rates, used for the AI usage report rather than for billing.
DSNLAI_AI_INPUT_COST_PER_MTOK=1.25
DSNLAI_AI_OUTPUT_COST_PER_MTOK=10.0

# Self-hosted open-weights model, the only route permitted for restricted
# content because nothing leaves the platform network.
DSNLAI_AI_LOCAL_BASE_URL=http://vllm:8000/v1
DSNLAI_AI_LOCAL_MODEL=local-open-weights

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── n8n, plumbing only ───────────────────────────────────────────────────────
# n8n polls approved mailboxes and posts to the signed ingest endpoint. It
# carries no legal logic and never writes to the database (PRD section 11.3).
DSNLAI_N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=
N8N_ENCRYPTION_KEY=

# ── code quality ─────────────────────────────────────────────────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=